# Packages a tree staged by packaging/build-rpm.sh (the binary is built
# outside rpmbuild, like the .deb). Run through that script, which passes
# `version` and `stage`. Library dependencies are generated by rpmbuild from
# the binary (soname based, so they resolve on Fedora, openSUSE and others).
Name:           linshot
Version:        %{version}
Release:        1
Summary:        Screenshot and annotation tool for X11 and Wayland
License:        GPL-3.0-or-later
URL:            https://github.com/adityatelange/linshot
Recommends:     xdg-desktop-portal
Suggests:       grim
Suggests:       wl-clipboard

# the binary is already stripped by cargo
%global debug_package %{nil}
%global __strip /bin/true

%description
Linshot captures regions, windows or full screens and opens them in an
annotation editor with rectangles, ellipses, arrows, freehand, text,
highlighter, pixelate/blur obfuscation, numbered step markers and crop.
Results can be saved, copied to the clipboard or printed.

Works on X11 (with Print-key hotkeys and window snapping) and on Wayland
(GNOME, KDE, Cinnamon, wlroots compositors such as Sway, Hyprland,
Wayfire, labwc, river and niri) natively or through xdg-desktop-portal.

%prep
# nothing to unpack: the files are staged already

%build
# built by packaging/build-rpm.sh

%install
mkdir -p %{buildroot}
cp -a %{stage}/usr %{buildroot}/

%files
%license /usr/share/licenses/linshot/LICENSE
%doc /usr/share/doc/linshot
/usr/bin/linshot
/usr/share/applications/io.github.linshot.Linshot.desktop
/usr/share/icons/hicolor/scalable/apps/*.svg

%changelog
* %(date "+%a %b %d %Y") Aditya Telange <21258296+adityatelange@users.noreply.github.com> - %{version}-1
- Release %{version}
